# Scripted is the default and requires no API key.
# Available now: scripted, openai. Gemini and Groq adapters are reserved for later.
GHOST_PROVIDER=scripted
# Copy to .env and paste your key there, never in frontend files.
OPENAI_API_KEY=
PORT=3000
# Fixed low-cost model: gpt-5.6-luna. No automatic model upgrades.
# OpenAI daily allowance; 0 makes OpenAI requests use scripted replies. Maximum permitted: 100.
MAX_DAILY_AI_REQUESTS=100
